# Maintainer: usse <https://github.com/ussego>
# Bump pkgver + checksums on each oma release (checksums: release sha256sums.txt).
# Release tarballs use Go arch names (amd64/arm64) in the inner dir; map
# from Arch's CARCH in package(). The source URLs are fixed literals.
case "$CARCH" in
	x86_64) goarch=amd64 ;;
	aarch64) goarch=arm64 ;;
esac
pkgname=oma-bin
pkgver=0.1.4
pkgrel=1
pkgdesc="SDK and CLI for building Omarchy shell plugins - plain JS logic, QML surfaces, single static binary"
arch=(x86_64 aarch64)
url="https://github.com/ussego/oma"
license=(MIT)
depends=(omarchy)
provides=(oma)
conflicts=(oma)
source_x86_64=("${url}/releases/download/v${pkgver}/oma-v${pkgver}-linux-amd64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/oma-v${pkgver}-linux-arm64.tar.gz")
sha256sums_x86_64=("56c2bf2005a646579ce7c92bb5e9f3ae65741e3eb731273d3ab06a3f5e538a4e")
sha256sums_aarch64=("a6ea066fabf4da4ac989c8c702c7f668857e4efbd536ae7c5d698db97a49dc58")

package() {
	install -Dm0755 "oma-v${pkgver}-linux-${goarch}/oma" "${pkgdir}/usr/bin/oma"
}
